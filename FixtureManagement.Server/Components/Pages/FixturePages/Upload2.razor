@page "/fixtures/upload2"
@attribute [Authorize]
@inject ITeamService TeamService
@inject IFixtureService FixtureService
@inject NavigationManager NavigationManager
@inject IFullTimeService FullTimeService
@using FixtureManagement.UI.Components
@using System.ComponentModel.DataAnnotations

<PageTitle>Upload Fixtures</PageTitle>

<h1>Upload Fixtures</h1>
<hr />
<h3>@team!.DisplayName</h3>
<p class="text-danger">@errorMessage</p>
<hr />
<form @formname="upload" @onsubmit="LoadFile" method="post" enctype="multipart/form-data" class="form-inline" Enhance>
    <div class="row">
        <div class="col-auto">
            <div class="d-flex align-items-end gap-2">
                <div>
                    <label for="file" class="form-label">Select CSV File</label>
                    <input type="file" name="file" class="form-control mt" />
                </div>
                <input type="hidden" name="teamiUploadTeamId" value="@UploadTeamId" />
                <button type="submit" class="btn btn-primary mt-2">Load</button>
            </div>
        </div </div>
        <AntiforgeryToken />
    </form>
    @if (team is not null && team.IsOnFullTime)
    {
        <form @formname="fromfulltime" @onsubmit="LoadFromFullTimeAsync" method="post" class="form-inline" Enhance>
            <div class="row">
                <div class="col-auto">
                    <div class="d-flex align-items-end gap-2">
                        <a href="@team.FixtureURL">@team.LeagueName</a>
                            <input type="hidden" name="teamiUploadTeamId" value="@UploadTeamId" />
                            <button type="submit" class="btn btn-primary mt-2">Load</button>
                        </div>
                    </div </div>
                    <AntiforgeryToken />
                </form>
            }
            <a href="#" onclick="history.back()" class="btn btn btn-secondary mt-2">Back</a>


            <form method="post" @formname="create" @onsubmit="CreateFixtures">
                @if (Fixtures.Count > 0)
                {
                    <table class="quickgrid table table-striped table-sm mt-4">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Venue</th>
                                <th>Opponent</th>
                                <th>Type</th>
                                <th><input id="select-all" value="true" checked type="checkbox" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fixture in Fixtures)
                            {
                                //FixtureManager.Models.Fixture fixture = item;
                                <tr>
                                    <td>
                                        <input type="hidden" name="UploadFixtures.Index" value="@fixture.Id" />
                                        <input type="hidden" name="UploadFixtures[@fixture.Id].Id" value="@fixture.Id" />
                                        <input type="hidden" name="UploadFixtures[@fixture.Id].Date"
                                               value="@fixture.Date.ToString("dd-MMM-yyyy")" />
                                        <input type="hidden" name="UploadFixtures[@fixture.Id].TeamId" value="@fixture.TeamId" />
                                        <input type="hidden" name="UploadFixtures[@fixture.Id].IsHome" value="@fixture.IsHome.ToString()" />
                                        <input type="hidden" name="UploadFixtures[@fixture.Id].Opponent" value="@fixture.Opponent" />
                                        <input type="hidden" name="UploadFixtures[@fixture.Id].FixtureType" value="@fixture.FixtureType" />

                                        @fixture.Date
                                    </td>
                                    <td>
                                        @(fixture.IsHome ? "Home" : "Away")
                                    </td>
                                    <td>
                                        @fixture.Opponent
                                    </td>
                                    <td>
                                        @fixture.FixtureType
                                        @* <input type="hidden" name="UploadFixtures[@fixture.Id].Fixture.FixtureType"
                    value="@fixture.FixtureType" /> *@
                                    </td>
                                    <td>
                                        <input name="UploadSelection[@fixture.Id]" checked value="true" type="checkbox"
                                               class="add-fixture" />
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">Create</button>
                    </div>

                }
                <AntiforgeryToken />
            </form>
            <code>@(FullTimeService.LastHtml)</code>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    document.getElementById("select-all").addEventListener("click", function () {
                        const checked = this.checked;
                        document.querySelectorAll(".add-fixture").forEach(function (el) {
                            el.checked = checked;
                        });
                    });
                });
            </script>
@code {

    [CascadingParameter]
    private FormMappingContext FormMappingContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "upload")]
    IFormFile? File { get; set; }

    [SupplyParameterFromQuery]
    @* [SupplyParameterFromForm(FormName = "upload")] *@
    Guid TeamId { get; set; }
    @* [SupplyParameterFromForm(FormName = "upload")] *@
    [SupplyParameterFromForm(FormName = "upload")]
    Guid UploadTeamId { get; set; }

    List<FixtureDto> Fixtures { get; set; } = new List<FixtureDto>();
    [SupplyParameterFromForm(FormName = "create")]
    Dictionary<Guid, FixtureDto> UploadFixtures { get; set; } = new();
    [SupplyParameterFromForm(FormName = "create")]
    Dictionary<Guid, bool> UploadSelection { get; set; } = new();
        private TeamDto? team { get; set; }
    private string? errorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        team ??= await TeamService.GetTeamAsync(TeamId);

        if (team is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }
        UploadTeamId = team.Id;
        var errors = FormMappingContext.GetAllErrors();



    }

    public async Task LoadFile()
    {
        if (File is null)
        {
            errorMessage = "Choose a CSV file first.";
            return;
        }
        // Same parser as the desktop app's upload page (FixtureManagement.UI/Components/FixtureCsv.cs).
        var result = await FixtureCsv.ReadAsync(File.OpenReadStream(), UploadTeamId);
        Fixtures = result.Fixtures.ToList();
        errorMessage = result.Error;
    }
    public async Task LoadFromFullTimeAsync()
    {
        if (team is null)
        {
            Console.WriteLine("Team is not loaded.");
            errorMessage = "Team is not loaded.";
            return;
        }
        try
        {
            var fulltimeFixtures = await FullTimeService.GetFixturesAsync(team);
            Fixtures = fulltimeFixtures.Select(ff => new FixtureDto
            {
                Id = Guid.NewGuid(),
                TeamId = UploadTeamId,
                Opponent = ff.Opponent,
                IsHome = ff.IsHome,
                Date = ff.Date,
                FixtureType = ff.FixtureType
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading from FullTime: {ex.Message}");
            errorMessage = $"Error loading from FullTime: {ex.Message}";
            return;
        }
    }

    public async Task CreateFixtures()
    {

        //Check if any fixtures are selected for upload
        if (UploadSelection is not null)
        {
            var fixtures = UploadFixtures
            .Where(f => UploadSelection.ContainsKey(f.Key) && UploadSelection[f.Key])
            .Select(f => f.Value);

            var result = await FixtureService.CreateFixturesAsync(fixtures.ToList());
            if (!result.Succeeded)
            {
                errorMessage = string.Join(" ", result.Errors.SelectMany(e => e.Value));
                return;
            }
        }
        NavigationManager.NavigateTo($"teams/details?id={UploadTeamId}");
    }

    public record UploadFixture
    {
        public required FixtureDto Fixture { get; set; }
        public bool Upload { get; set; }
    }
}
