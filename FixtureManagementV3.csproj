<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-FixtureManagementV3-a56d5c1a-c165-4abc-8029-e7cc64e5f838</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Data\app.db" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />  
    <None Update="Data\local.db" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="FixtureManagementV3.Client/**/*.cs" />
    <Compile Remove="FixtureManagementV3.Client/**/*.razor" />
    <Content Remove="FixtureManagementV3.Client/**" />
    <None Remove="FixtureManagementV3.Client/**" />

    <Compile Remove="FixtureManagement.Shared/**/*.cs" />
    <Compile Remove="FixtureManagement.Shared/**/*.razor" />
    <Content Remove="FixtureManagement.Shared/**" />
    <None Remove="FixtureManagement.Shared/**" />

    <Compile Remove="FixtureManagement.UI/**/*.cs" />
    <Compile Remove="FixtureManagement.UI/**/*.razor" />
    <Content Remove="FixtureManagement.UI/**" />
    <None Remove="FixtureManagement.UI/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid.EntityFrameworkAdapter" Version="9.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="9.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.7" />
    <ProjectReference Include="FixtureManagementV3.Client\FixtureManagementV3.Client.csproj" />
    <ProjectReference Include="FixtureManagement.Shared\FixtureManagement.Shared.csproj" />
    <ProjectReference Include="FixtureManagement.UI\FixtureManagement.UI.csproj" />
  </ItemGroup>

</Project>