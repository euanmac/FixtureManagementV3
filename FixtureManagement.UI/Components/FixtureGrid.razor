@preservewhitespace true
@inject NavigationManager NavigationManager

@* Fixture list used by the fixtures page and team details.
   Pitch and kick-off are shown only once confirmed, unless the viewer can edit. *@
<div>
    <QuickGrid Items="rows" Theme="corporate" id="fixtures" class="table table-striped table-sm">
        <PropertyColumn Property="fixture => fixture.Date" />
        @if (!TeamHidden)
        {
            <TemplateColumn Context="fixture" title="Team">
                <a href="@($"teams/details?id={fixture.TeamId}")">@fixture.Team.DisplayName</a>
            </TemplateColumn>
        }
        <PropertyColumn Title="H/A" Property='fixture => (fixture.IsHome ? "H" : "A")'/>
        <TemplateColumn Context="fixture" title="Opponent">
            <a data-enhance-nav="false" href="@($"fixtures/{(CanEdit ? "edit" : "details")}?id={fixture.Id}")">@fixture.Opponent</a>
        </TemplateColumn>
        <PropertyColumn Title="Type" Property="fixture => fixture.FixtureTypeShortName" Class="d-none d-sm-table-cell"/>
        <TemplateColumn Context="fixture" Title="Start">
            @if (ShowAllocation(fixture))
            {
                @fixture.Allocation!.Start.ToString("HH:mm")
            }
        </TemplateColumn>
        <TemplateColumn Context="fixture" Title="Pitch">
            @if (ShowAllocation(fixture))
            {
                @fixture.Allocation!.PitchName
            }
        </TemplateColumn>
        <TemplateColumn Context="fixture">
            @if (CanEdit)
            {
                <a data-enhance-nav="false" href="@(ActionURL("edit", fixture.Id))"><Icon Type="Icon.IconType.Edit"/></a>
                <a href="@(ActionURL("delete", fixture.Id))"><Icon Type="Icon.IconType.Delete"/></a>
                @if (fixture.IsHome) {
                    <a href="@(ActionURL("allocate", fixture.Id))"><Icon Type="Icon.IconType.Schedule"/></a>
                }
            }
        </TemplateColumn>
    </QuickGrid>
</div>

@code {
    [Parameter, EditorRequired]
    public required IEnumerable<FixtureDto> Fixtures { get; set; }
    [Parameter]
    public bool CanEdit { get; set; }
    [Parameter]
    public bool TeamHidden { get; set; } = true;

    private IQueryable<FixtureDto> rows = Enumerable.Empty<FixtureDto>().AsQueryable();

    protected override void OnParametersSet() => rows = Fixtures.AsQueryable();

    private bool ShowAllocation(FixtureDto fixture) =>
        fixture.IsAllocated && (fixture.Allocation!.IsConfirmed || CanEdit);

    private string ActionURL(string action, Guid id) =>
        $"fixtures/{action}?id={id}&returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}";
}
