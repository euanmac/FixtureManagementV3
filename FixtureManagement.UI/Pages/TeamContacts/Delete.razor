@page "/teamcontacts/delete"
@attribute [Authorize]
@inject ITeamContactService TeamContactService
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this? The person stays on the contacts list; only their link to the team is removed.</p>
<div>
    <h2>Team Contact</h2>
    <hr />
    @if (contact is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Team</dt>
            <dd class="col-sm-10">@contact.Team.DisplayName</dd>
            <dt class="col-sm-2">Contact Type</dt>
            <dd class="col-sm-10">@contact.ContactType</dd>
            <dt class="col-sm-2">Person</dt>
            <dd class="col-sm-10">@contact.FullName</dd>
        </dl>
        <EditForm method="post" Model="contact" OnValidSubmit="DeleteTeamContact" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger">Delete</button> |
            <a href="/teamcontacts">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private TeamContactDto? contact;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        contact = await TeamContactService.GetTeamContactAsync(Id);

        if (contact is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteTeamContact()
    {
        await TeamContactService.DeleteTeamContactAsync(Id);
        NavigationManager.NavigateTo("/teamcontacts");
    }
}
