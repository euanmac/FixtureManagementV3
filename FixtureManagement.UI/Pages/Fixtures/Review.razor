@page "/fixtures/review"
@attribute [Authorize]
@using FixtureManagement.Shared.Reconciliation
@inject IReconciliationService ReconciliationService
@inject ITeamService TeamService
@inject IFixtureService FixtureService
@inject NavigationManager NavigationManager
@* Review FullTime, grouped by team (the earlier layout, grouped by kind of difference, is /fixtures/review/sections).
   Every team, with all its fixtures
   from today compared with the latest FullTime uploads – the same rows and statuses as Gameweek – in collapsible
   sections that start closed; the header says what needs resolving. Each difference has icon buttons that apply a
   choice at once (same IReconciliationService.ApplyAsync as Review FullTime). *@

<PageTitle>Fixture Review</PageTitle>

<h1>Fixture Review</h1>
<hr />

@if (rows is null)
{
    <p><em>Loading…</em></p>
}
else
{
    @if (week?.Upload is null)
    {
        <div class="alert alert-info py-2">
            Nothing has been fetched from FullTime yet, so fixtures aren't compared. Use the Fixture Manager browser
            extension: open a FullTime page, then click <strong>Send fixtures from FullTime</strong>.
        </div>
    }
    else
    {
        <p class="text-muted small mb-2">
            Fixtures from @today.ToString("d MMM yyyy") compared with the latest FullTime fetch
            (@week.Upload.UploadedAt.ToLocalTime().ToString("ddd d MMM HH:mm") by @week.Upload.UploadedBy).
        </p>
    }

    @* No "added / updated" banner – the reloaded row shows the result. Only a failure is reported. *@
    @if (applied is not null && applied.Errors.Count > 0)
    {
        <div class="alert alert-warning py-2" role="alert">
            <ul class="mb-0">
                @foreach (var error in applied.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @* Filters: toggle buttons that put the choice in the address, as on Review FullTime. *@
    <div class="mb-2">
        <FilterRow Label="FullTime" Options="FullTimeFilterOptions()" />
        <FilterRow Label="League" Options="LeagueFilterOptions()" />
        <FilterRow Label="Age group" Options="AgeFilterOptions()" />
        @if (filterLeague.Count > 0 || filterAge.Count > 0 || filterTeam.Count > 0)
        {
            <FilterRow Label="Team" Options="TeamFilterOptions()" />
        }
    </div>
    <p class="small text-muted">
        @VisibleTeams.Count() teams, @VisibleTeams.Count(t => IssueCount(t) > 0) with something to resolve.
        @if (IsFiltered)
        {
            <a href="fixtures/review?ft=all">Show all</a>
        }
    </p>

    <EditForm Model="this" OnSubmit="ApplyAsync" FormName="apply" Enhance>
        @foreach (var team in VisibleTeams)
        {
            var teamRows = TeamRows(team);
            var issues = IssueCount(team);
            var accepted = teamRows.Count(r => r.RecStatus == FixtureRecMatchType.fullTimeAccepted);
            <details class="team-section" open="@(team.Id == openTeam)">
                <summary class="team-summary">
                    <span class="team-name">@team.DisplayName</span>
                    <span class="small text-muted">@team.LeagueName</span>
                    @if (issues > 0)
                    {
                        <span class="badge text-bg-warning">@issues to resolve</span>
                    }
                    else if (!team.IsOnFullTime)
                    {
                        <span class="badge text-bg-secondary">Not on FullTime</span>
                    }
                    @if (accepted > 0)
                    {
                        <span class="badge text-bg-secondary">@accepted accepted</span>
                    }
                    @if (team.IsOnFullTime && week?.Upload is not null && !week.CoveredTeamIds.Contains(team.Id))
                    {
                        <span class="badge text-bg-info">Not fetched from FullTime</span>
                    }
                    else if (teamRows.Count > 0 && teamRows.All(r => r.RecStatus == FixtureRecMatchType.fullTimematched))
                    {
                        <span class="badge text-bg-success">All match</span>
                    }
                    <span class="small text-muted ms-auto">@teamRows.Count @(teamRows.Count == 1 ? "fixture" : "fixtures")</span>
                </summary>

                @if (teamRows.Count == 0)
                {
                    <p class="text-muted small ms-4 my-2">No fixtures from today.</p>
                }
                else
                {
                    <table class="table table-sm review-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Venue</th>
                                <th>Type</th>
                                <th>Opponent</th>
                                <th>Pitch</th>
                                <th>Start</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ DateOnly? lastDate = null; var shade = false; }
                            @foreach (var row in teamRows)
                            {
                                // Gameweek style: games on the same day share the date (shown once) and the shading.
                                var newDate = row.MatchDate != lastDate;
                                if (newDate) shade = !shade;
                                lastDate = row.MatchDate;
                                <tr class="@(shade ? "shaded" : "")">
                                    <td class="text-nowrap">@(newDate ? row.MatchDate.ToString("ddd dd/MM/yy") : "")</td>
                                    <td>
                                        <i class="@StatusIcon(row)" title="@StatusText(row)"></i>
                                        <span class="ms-1">@StatusText(row)</span>
                                        @if (row.Note.Length > 0)
                                        {
                                            <div class="small text-muted">@row.Note</div>
                                        }
                                    </td>
                                    <td>@row.Venue</td>
                                    <td>@row.FixtureType.DisplayName()</td>
                                    <td>@row.Opponent</td>
                                    <td>@(row.IsAllocated ? row.Pitch : "")</td>
                                    <td>@(row.IsAllocated ? row.Start.ToShortTimeString() : "")</td>
                                    <td class="text-end text-nowrap">
                                        @if (row.ItemId.Length > 0)
                                        {
                                            @ActionButton(team, row, Resolution.UseSource)
                                            @* Accepted already: only the way back to FullTime's version is offered. *@
                                            @if (row.RecStatus != FixtureRecMatchType.fullTimeAccepted)
                                            {
                                                @ActionButton(team, row, Resolution.KeepApp)
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </details>
        }
    </EditForm>
}

@code {
    private const string Source = "FullTime";

    private DateOnly today;
    private ReconciliationWeekDto? week;
    private IReadOnlyList<TeamDto> teams = [];
    private Dictionary<TeamDto, List<TeamReconiliationRow>>? rows;
    private ReconciliationApplyResultDto? applied;
    private Guid? openTeam;
    private bool busy;

    // Which action button was pressed: "{teamId}|{itemId}|{UseSource|KeepApp}". Static site: posted as the button's
    // name/value; interactive (desktop): the click records it. No initializer (BL0008): a form post sets it.
    [SupplyParameterFromForm(FormName = "apply")]
    public string? RowAction { get; set; }
    private string? clickedAction;

    // Filters, from the address; each can be given several times. None = no filter on that row, except FullTime:
    // with no "ft" it shows teams on FullTime only, and "ft=all" turns that off.
    [SupplyParameterFromQuery(Name = "ft")] public string[]? FullTime { get; set; }
    [SupplyParameterFromQuery(Name = "league")] public string[]? League { get; set; }
    [SupplyParameterFromQuery(Name = "age")] public string[]? Age { get; set; }
    [SupplyParameterFromQuery(Name = "team")] public string[]? Team { get; set; }

    private HashSet<string> filterFullTime = [], filterLeague = [], filterAge = [], filterTeam = [];

    protected override void OnParametersSet()
    {
        static HashSet<string> Set(string[]? values) => (values ?? []).Where(v => !string.IsNullOrEmpty(v)).ToHashSet();
        filterFullTime = FullTime is null || FullTime.Length == 0 ? [FullTimeDefault] : Set(FullTime.Where(v => v != FullTimeAll).ToArray());
        filterLeague = Set(League);
        filterAge = Set(Age);
        filterTeam = Set(Team);
    }

    protected override async Task OnInitializedAsync()
    {
        // On a static post, ApplyAsync runs after this and reloads.
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        today = DateOnly.FromDateTime(DateTime.Today);
        teams = await TeamService.GetTeamsAsync();
        var fixtures = await FixtureService.GetFixturesAsync(new FixtureQuery { From = today });
        week = await ReconciliationService.GetWeekAsync(Source, today, DateOnly.MaxValue);
        rows = GameweekRows.Build(teams, today, DateOnly.MaxValue, fixtures, week);
    }

    private List<TeamReconiliationRow> TeamRows(TeamDto team) =>
        rows is not null && rows.TryGetValue(team, out var list)
            ? list.Where(r => r.RecStatus != FixtureRecMatchType.noFixture).ToList()
            : [];

    /// <summary>Differences still to decide (accepted ones are decided).</summary>
    private int IssueCount(TeamDto team) => TeamRows(team).Count(r => r.ItemId.Length > 0 && r.RecStatus != FixtureRecMatchType.fullTimeAccepted);

    private async Task ApplyAsync()
    {
        var parts = (RowAction ?? clickedAction ?? "").Split('|');
        clickedAction = null;
        if (parts.Length != 3 || !Guid.TryParse(parts[0], out var teamId)
            || !Enum.TryParse<Resolution>(parts[2], out var side) || side is not (Resolution.UseSource or Resolution.KeepApp))
            return;

        busy = true;
        try
        {
            applied = await ReconciliationService.ApplyAsync(Source, new Dictionary<string, Resolution> { [parts[1]] = side });
            openTeam = teamId;          // keep the team just worked on open after the reload
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>
    /// A fixture's icon button: what it does for this kind of row, and a tooltip saying so. Taking FullTime's version
    /// (adding the fixture, or using its details) uses Gameweek's download-from-FullTime cloud.
    /// </summary>
    private RenderFragment ActionButton(TeamDto team, TeamReconiliationRow row, Resolution side) => builder =>
    {
        var (icon, title) = (row.Difference, side) switch
        {
            (DifferenceKind.OnlyInSource, Resolution.UseSource) => (Icon.IconType.CloudDownload, "Add this FullTime fixture to Fixture Manager"),
            (DifferenceKind.OnlyInSource, _) => (Icon.IconType.Warning, "Don't add it (remembered)"),
            (DifferenceKind.OnlyInApp, Resolution.UseSource) => (Icon.IconType.Delete, "Delete it – it isn't on FullTime"),
            (_, Resolution.UseSource) => (Icon.IconType.CloudDownload, "Use FullTime's details"),
            _ => (Icon.IconType.Warning, "Keep Fixture Manager's version (remembered)"),
        };
        var value = $"{team.Id}|{row.ItemId}|{side}";
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "submit");
        builder.AddAttribute(2, "class", "btn btn-sm btn-dark ms-1");      // black/very dark grey, white icon
        builder.AddAttribute(3, "name", "RowAction");
        builder.AddAttribute(4, "value", value);
        builder.AddAttribute(5, "title", title);
        builder.AddAttribute(6, "aria-label", title);
        builder.AddAttribute(7, "disabled", busy);
        builder.AddAttribute(8, "onclick", EventCallback.Factory.Create(this, () => clickedAction = value));
        builder.OpenComponent<Icon>(9);
        builder.AddComponentParameter(10, nameof(Icon.Type), icon);
        builder.CloseComponent();
        builder.CloseElement();
    };

    private static string StatusText(TeamReconiliationRow row) => row.RecStatus switch
    {
        FixtureRecMatchType.fullTimematched => "Matches FullTime",
        FixtureRecMatchType.fullTimeUnmatched => "Missing from Fixture Manager",
        FixtureRecMatchType.localFixtureUnmatched => "Not on FullTime",
        FixtureRecMatchType.fullTimeDifferent => "Differs from FullTime",
        FixtureRecMatchType.fullTimeAccepted => "Accepted",
        FixtureRecMatchType.localFixtureOnly => row.Team.IsOnFullTime ? "Fixture Manager only" : "Team not on FullTime",
        _ => row.RecStatus.DisplayName(),
    };

    /// <summary>As Gameweek: anything needing a decision gets the warning triangle.</summary>
    private static string StatusIcon(TeamReconiliationRow row) =>
        row.RecStatus is FixtureRecMatchType.fullTimeDifferent or FixtureRecMatchType.localFixtureUnmatched
            ? "bi bi-exclamation-triangle text-warning"
            : row.GetRecIcon();

    // ---------- filters (by team) ----------

    private const string FullTimeDefault = "on", FullTimeAll = "all";

    private bool IsFiltered => filterFullTime.Count + filterLeague.Count + filterAge.Count + filterTeam.Count > 0;

    private static bool Matches(HashSet<string> filter, string value) => filter.Count == 0 || filter.Contains(value);

    private static string FullTimeValue(TeamDto team) => team.IsOnFullTime ? "on" : "off";

    private IEnumerable<TeamDto> TeamsExcept(params string[] ignore) =>
        teams.Where(t =>
            (ignore.Contains("ft") || Matches(filterFullTime, FullTimeValue(t)))
            && (ignore.Contains("league") || Matches(filterLeague, t.League.ToString()))
            && (ignore.Contains("age") || Matches(filterAge, t.AgeGroup.ToString()))
            && (ignore.Contains("team") || Matches(filterTeam, t.Id.ToString())));

    private IEnumerable<TeamDto> VisibleTeams => TeamsExcept();

    /// <summary>A row of toggle buttons with team counts; changing FullTime / league / age drops teams that no longer fit.</summary>
    private IReadOnlyList<FilterOption> Options(string key, HashSet<string> selected, IEnumerable<(string Value, string Label)> values,
        Func<TeamDto, string> valueOf, bool narrowsTeams = false)
    {
        var counted = (narrowsTeams ? TeamsExcept(key, "team") : TeamsExcept(key)).ToList();
        string Url(string value)
        {
            var toggled = selected.Contains(value) ? selected.Where(v => v != value).ToArray() : [.. selected, value];
            // No "ft" means the default (on FullTime), so clearing that row needs "ft=all".
            var changes = new Dictionary<string, object?> { [key] = toggled.Length > 0 ? toggled : key == "ft" ? new[] { FullTimeAll } : null };
            if (narrowsTeams)
            {
                var ft = key == "ft" ? toggled.ToHashSet() : filterFullTime;
                var leagues = key == "league" ? toggled.ToHashSet() : filterLeague;
                var ages = key == "age" ? toggled.ToHashSet() : filterAge;
                var kept = leagues.Count == 0 && ages.Count == 0 ? [] : teams
                    .Where(t => filterTeam.Contains(t.Id.ToString()) && Matches(ft, FullTimeValue(t))
                                && Matches(leagues, t.League.ToString()) && Matches(ages, t.AgeGroup.ToString()))
                    .Select(t => t.Id.ToString()).ToArray();
                changes["team"] = kept.Length == 0 ? null : kept;
            }
            return NavigationManager.GetUriWithQueryParameters(changes);
        }
        var options = new List<FilterOption>();
        foreach (var (value, label) in values)
        {
            int count = counted.Count(t => valueOf(t) == value);
            if (count > 0 || selected.Contains(value)) options.Add(new FilterOption(label, count, selected.Contains(value), Url(value)));
        }
        return options;
    }

    private IReadOnlyList<FilterOption> FullTimeFilterOptions() =>
        Options("ft", filterFullTime, [("on", "On FullTime"), ("off", "Not on FullTime")], FullTimeValue, narrowsTeams: true);

    private IReadOnlyList<FilterOption> LeagueFilterOptions() =>
        Options("league", filterLeague,
            teams.Select(t => t.League).Distinct().OrderBy(l => l.DisplayName()).Select(l => (l.ToString(), l.DisplayName())),
            t => t.League.ToString(), narrowsTeams: true);

    private IReadOnlyList<FilterOption> AgeFilterOptions() =>
        Options("age", filterAge,
            teams.Select(t => t.AgeGroup).Distinct().Order().Select(a => (a.ToString(), a.ToString())),
            t => t.AgeGroup.ToString(), narrowsTeams: true);

    private IReadOnlyList<FilterOption> TeamFilterOptions() =>
        Options("team", filterTeam, TeamsExcept("team").OrderBy(t => t.DisplayName).Select(t => (t.Id.ToString(), t.DisplayName)),
            t => t.Id.ToString());
}
