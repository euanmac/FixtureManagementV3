<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:app="clr-namespace:FixtureManagement.App;assembly=FixtureManagement.App"
             x:Class="FixtureManagement.Desktop.MainPage">

    <!-- The whole UI is Blazor: FixtureManagement.App's Routes (sign-in, layout, and the shared pages). -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type app:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
