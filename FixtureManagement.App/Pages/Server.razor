@page "/server"
@inject AppSettings AppSettings
@inject ApiAuthClient AuthClient
@inject NavigationManager NavigationManager
@using FixtureManagement.FullTime

<PageTitle>Server</PageTitle>

<h1>Server</h1>

<p>
    The app reads and saves everything through this website.
    @if (AppSettings.IsDefaultServer)
    {
        <span>It's using the live site.</span>
    }
    else
    {
        <span class="text-warning">It's <strong>not</strong> using the live site
            (@AppSettings.DefaultServerAddress.Host).</span>
    }
</p>

<div class="row">
    <div class="col-md-6">
        <div class="mb-3">
            <label for="address" class="form-label">Server address</label>
            <input id="address" class="form-control" @bind="addressText" @bind:event="oninput" />
            @if (error is not null)
            {
                <div class="text-danger">@error</div>
            }
            <div class="form-text">Changing it signs you out; sign in with your account on the new server.</div>
        </div>

        <button type="button" class="btn btn-primary" @onclick="Save">Save</button>
        @if (!AppSettings.IsDefaultServer)
        {
            <button type="button" class="btn btn-outline-secondary ms-2" @onclick="UseLiveSite">Use the live site</button>
        }
    </div>
</div>

<h2 class="h4 mt-5">Reading FullTime</h2>

<p>How the app downloads team pages from FullTime (Gameweek). A change applies to the next page it reads.</p>

<div class="mb-3">
    <div class="form-check">
        <input class="form-check-input" type="radio" name="fullTimeLoader" id="loader-htmlweb"
               checked="@(AppSettings.FullTimePageLoader == FullTimePageLoaderKind.HtmlWeb)"
               @onchange="() => SetLoader(FullTimePageLoaderKind.HtmlWeb)" />
        <label class="form-check-label" for="loader-htmlweb">Directly (standard)</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="radio" name="fullTimeLoader" id="loader-selenium"
               checked="@(AppSettings.FullTimePageLoader == FullTimePageLoaderKind.Selenium)"
               @onchange="() => SetLoader(FullTimePageLoaderKind.Selenium)" />
        <label class="form-check-label" for="loader-selenium">Through Google Chrome (Selenium)</label>
    </div>
    <div class="form-text">
        Try Chrome if FullTime refuses the app. It needs Google Chrome installed. A Chrome window opens while the
        app reads FullTime, and closes when you switch back or quit the app.
    </div>
</div>

@code {
    private string? addressText;
    private string? error;

    protected override void OnInitialized() => addressText = AppSettings.ServerAddress.AbsoluteUri;

    private void Save()
    {
        if (!ServerAddressParser.TryParse(addressText, out var address, out var parseError))
        {
            error = parseError;
            return;
        }
        error = null;
        if (address! == AppSettings.ServerAddress)
        {
            NavigationManager.NavigateTo("");
            return;
        }
        Switch(address!);
    }

    private void SetLoader(FullTimePageLoaderKind kind) => AppSettings.SetFullTimePageLoader(kind);

    private void UseLiveSite() => Switch(AppSettings.DefaultServerAddress);

    private void Switch(Uri address)
    {
        // The tokens belong to the old server, so sign out before pointing the app elsewhere.
        AuthClient.SignOut();
        AppSettings.SetServerAddress(address);
        NavigationManager.NavigateTo("login");
    }
}
