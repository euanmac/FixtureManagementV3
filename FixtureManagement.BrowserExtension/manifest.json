{
  "manifest_version": 3,
  "name": "Fixture Manager – FullTime",
  "version": "1.0.0",
  "description": "Fetches your club's FullTime team pages in this browser, when you click Send, and sends them to Fixture Manager.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fixture Manager – FullTime",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://fulltime.thefa.com/*",
    "https://tufixturemanager.azurewebsites.net/*",
    "https://tufixturemanager-qa.azurewebsites.net/*",
    "https://euanblazortest2.azurewebsites.net/*",
    "https://localhost/*"
  ]
}
