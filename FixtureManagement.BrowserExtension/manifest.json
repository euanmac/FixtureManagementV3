{
  "manifest_version": 3,
  "name": "Fixture Manager – FullTime",
  "version": "0.1.0",
  "description": "Fetches your club's FullTime team pages in this browser, when you click Send, and sends them to Fixture Manager.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fixture Manager – FullTime"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://fulltime.thefa.com/*",
    "https://*.azurewebsites.net/*",
    "https://localhost/*"
  ]
}
